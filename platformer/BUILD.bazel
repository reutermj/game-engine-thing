load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//engine:defs.bzl", "POISON_ENV", "engine_game")
load("//engine:sanitize.bzl", "sanitized_tests")

# A platformer for a player that takes turns, on the lockstep bootstrap.
#
#   ./bazel run //platformer                                         # the engine
#   bazel-bin/engine/modctl/modctl send platformer_text right        # run, jump, ...
#   bazel-bin/engine/modctl/modctl send lockstep step 20             # advance time
#   bazel-bin/engine/modctl/modctl send platformer_text show         # look
engine_game(
    name = "platformer",
    bootstrap = "//engine/std/lockstep",
    mods = [
        "//platformer/level",
        "//platformer/text",
    ],
)

TEST_DATA = {
    "LEVEL_ALT_CODE": "//platformer/level:level_alt_code",
    "LEVEL_ALT_MAP": "//platformer/level:level_alt_map",
    # The game target's output is its manifest; its runfiles have every mod.
    "MANIFEST": ":platformer",
}

rust_test(
    name = "platformer_test",
    srcs = ["platformer_test.rs"],
    data = TEST_DATA.values(),
    env = {var: "$(rlocationpath %s)" % target for var, target in TEST_DATA.items()} | POISON_ENV,
    deps = [
        "//engine/control",
        "//engine/loader",
        "@rules_rust//rust/runfiles",
    ],
)

# Twins of every mod that isn't resident, by mod name: see
# //engine/tests:replay.rs.
PLATFORMER_TWINS = {
    "physics": "//engine/std/physics:physics_twin",
    "platformer": "//platformer/core:core_twin",
    "walkers": "//platformer/walkers:walkers_twin",
    "level": "//platformer/level:level_twin",
    "platformer_text": "//platformer/text:text_twin",
    "sequential": "//engine/std/sequential:sequential_twin",
}

# The routes in platformer_test, again while reloading the game's mods under
# them.
rust_test(
    name = "reload_test",
    srcs = ["reload_test.rs"],
    data = [":platformer"] + PLATFORMER_TWINS.values(),
    env = {
        "MANIFEST": "$(rlocationpath :platformer)",
        "TWINS": ";".join(["%s=$(rlocationpath %s)" % (name, twin) for name, twin in PLATFORMER_TWINS.items()]),
    },
    deps = [
        "//engine/loader",
        "//engine/tests:replay",
        "//platformer/core:core_interface",
        "//platformer/walkers:walkers_interface",
    ],
)

# platformer_test_asan; see docs/runbooks/004-run-the-loader-under-sanitizers.md.
sanitized_tests(tests = [":platformer_test"])
