# Keep the build hermetic: never pick up a C/C++ toolchain from the host.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1

try-import %workspace%/user.bazelrc

# Tests run side by side, many engines to a test, and each engine's thread
# pool pinned to one CCD would pile them all on its cores: in tests the OS
# places the pools' threads (docs/architecture/threads.md, "Placement").
# On common, so build, test and run keep one configuration.
common --test_env=ENGINE_PIN=0

# Optimized by default, tests and games alike. The physics tests are pure
# number-crunching and run about 40 times faster (quality_test 49 s to about
# 1 s, results bit for bit the same: rustc doesn't reorder float arithmetic),
# and a game's physics is only realistic optimized. The cost is a few seconds
# more per physics rebuild (the physics mod 1.2 s to 3.9 s after a solver
# edit). One mode for the engine, its mods and its tests also means a hot
# reload never loads a mod built in another mode than the engine it joins.
# Debug assertions and overflow checks stay on, so tests check what they did
# in fastbuild. --config=bench turns them off, for timings that match what
# ships (the list setting, unlike extra_rustc_flag, is replaced, not added to).
common --compilation_mode=opt
common --@rules_rust//rust/settings:extra_rustc_flags=-Cdebug-assertions=on,-Coverflow-checks=on
common:bench --@rules_rust//rust/settings:extra_rustc_flags=

# rustc surfaces clang's "unused --unwindlib" note from the hermetic linker as a warning.
common --@rules_rust//rust/settings:extra_rustc_flag=-Alinker_messages
common --@rules_rust//rust/settings:extra_exec_rustc_flag=-Alinker_messages


# Clippy runs as an aspect over every Rust target that bazel test builds, so a
# lint fails the test run like a compile error does. Not on build or run: a
# lint should not block a hot reload mid-edit. ./bazel build --config=lint
# lints without testing. Levels are clippy-only flags, so they sit on common:
# a Starlark flag that differs between build and test would discard the
# analysis cache on every switch.
common --@rules_rust//rust/settings:clippy_flag=-Dwarnings
# The access declaration is the system signature: its Query types and its
# parameter count are the API, and an alias or a struct would hide them.
common --@rules_rust//rust/settings:clippy_flag=-Aclippy::type_complexity
common --@rules_rust//rust/settings:clippy_flag=-Aclippy::too_many_arguments
# Storage and solver loops index several parallel arrays by one index.
common --@rules_rust//rust/settings:clippy_flag=-Aclippy::needless_range_loop
# clippy.toml names the thread spawns mods may not make; outside mods they're
# fine (the loader's socket thread, tests, the threads mod's pool). Allowed
# here, and forbidden in mods by //engine:mod_lints: a forbid from the
# target's lint_config, which comes first, outlasts this later allow.
common --@rules_rust//rust/settings:clippy_flag=-Aclippy::disallowed_methods
common --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
test --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
test --output_groups=+clippy_checks
# And formatting, the same way: an unformatted file fails the test run.
# ./bazel run @rules_rust//:rustfmt formats everything.
test --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
test --output_groups=+rustfmt_checks
build:lint --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build:lint --output_groups=+clippy_checks

# rustfmt reads its config from a label flag, not from the workspace: without
# this it formats to its defaults (100 columns) whatever rustfmt.toml says.
common --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml
