load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//engine:defs.bzl", "engine_mod")

# What a game declares to be playable by a person or an agent with no glue:
# its seats, actions (with default keys and gamepad controls), the events
# it reports, its goals and metrics, presentation.md D4 and D7. Runs
# nothing. Resident, because bootstraps map devices to actions through it;
# on the platform for the names of the controls.
engine_mod(
    name = "play",
    srcs = ["lib.rs"],
    interface = [
        "play.rs",
        "actions.rs",
        "events.rs",
        "goals.rs",
    ],
    mod_deps = ["//engine/std/platform"],
    resident = True,
    visibility = ["//visibility:public"],
)

rust_test(
    name = "play_test",
    srcs = ["tests/play_test.rs"],
    deps = [
        ":play_interface",
        "//engine/ecs",
        "//engine/std/platform:platform_interface",
    ],
)
