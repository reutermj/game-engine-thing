load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//engine:defs.bzl", "engine_game", "engine_mod")

# //engine/std/physics2d against Box2D v3 and Rapier 2D, on the same scenes,
# one thread each: time per step by stage, and how well each settles. The
# two libraries are for this package alone; nothing else may depend on them.
# See docs/architecture/physics.md, "Against other engines", and
# docs/runbooks/005-compare-physics-with-other-engines.md.
#
#   ./bazel run --config=bench //engine/std/physics2d/compare

package(default_visibility = ["//visibility:private"])

# The scenes, built in the engine by a mod from the same code the other
# engines build them from.
engine_mod(
    name = "scene",
    srcs = [
        "scene.rs",
        "scene_mod.rs",
    ],
    crate_root = "scene_mod.rs",
    mod_deps = ["//engine/std/physics2d"],
)

engine_game(
    name = "scene_game",
    bootstrap = "//engine/std/lockstep",
    mods = [":scene"],
)

cc_library(
    name = "box2d_shim",
    srcs = ["box2d_shim.c"],
    copts = ["-O3"],
    deps = ["@box2d"],
)

rust_binary(
    name = "compare",
    srcs = [
        "behave.rs",
        "bounces.rs",
        "box2d.rs",
        "compare.rs",
        "ecs.rs",
        "family.rs",
        "quality.rs",
        "rapier.rs",
        "scene.rs",
        "settle.rs",
        "sim.rs",
        "variants.rs",
        "view.rs",
        "//engine/std/physics2d:narrow.rs",
        "//engine/std/physics2d:solver.rs",
        "//engine/std/physics2d:tests/split_impulse.rs",
        "//engine/std/physics2d:tests/arrays.rs",
        "//engine/std/physics2d:tests/pool.rs",
    ],
    crate_root = "compare.rs",
    # The two libraries' licenses travel with the binary that contains
    # them: see docs/CREDITS.md.
    data = [
        ":scene_game",
        "licenses/rapier-LICENSE",
        "@box2d//:LICENSE",
    ],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    deps = [
        ":box2d_shim",
        "//engine/control",
        "//engine/ecs",
        "//engine/loader",
        "//engine/std/physics2d:physics2d_interface",
        "//engine/std/physics_common",
        "//engine/std/physics_testkit",
        "@crates//:rapier2d",
    ],
)

# What the quality and behaviour tests share: the comparison's scenes,
# measures and our step on arrays, the runs each binary makes once
# (runs.rs), and the baseline they are held to (record.rs, and the files,
# built in; the format is //engine/std/physics_testkit's).
MEASURE_SRCS = [
    "behave.rs",
    "bounces.rs",
    "ecs.rs",
    "family.rs",
    "quality.rs",
    "record.rs",
    "runs.rs",
    "scene.rs",
    "settle.rs",
    "sim.rs",
    "variants.rs",
    "//engine/std/physics2d:narrow.rs",
    "//engine/std/physics2d:solver.rs",
    "//engine/std/physics2d:tests/split_impulse.rs",
    "//engine/std/physics2d:tests/arrays.rs",
]

BASELINES = [
    "baseline.txt",
    "baseline_long.txt",
]

QUALITY_SRCS = MEASURE_SRCS + ["quality_test.rs"]

QUALITY_DEPS = [
    "//engine/control",
    "//engine/ecs",
    "//engine/loader",
    "//engine/std/physics2d:physics2d_interface",
    "//engine/std/physics_common",
    "//engine/std/physics_testkit",
]

# Quality as a test: how soon piles, pyramids and stacks come to rest, how
# deep they sink, what energy is left and that sleeping follows, bounded by
# what Box2D and Rapier meet on the same scenes (recorded, not linked). See
# the source, and physics.md, "Quality as a test". SOLVER=(a variant) in the
# environment runs one of variants.rs instead of ours.
rust_test(
    name = "quality_test",
    srcs = QUALITY_SRCS,
    compile_data = BASELINES,
    crate_root = "quality_test.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    deps = QUALITY_DEPS,
)

# The same at 10 000 bodies: minutes, so manual, and meant for -c opt:
#   ./bazel test //engine/std/physics2d/compare:quality_long_test
rust_test(
    name = "quality_long_test",
    srcs = QUALITY_SRCS + ["quality_long.rs"],
    compile_data = BASELINES,
    crate_features = ["long"],
    crate_root = "quality_test.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    tags = ["manual"],
    deps = QUALITY_DEPS,
)

# Quality beyond settling: what a player sees a body do (a box on a ramp, a
# disc rolling, a ball bouncing, heavy boxes on light ones, overlap pushed
# apart, a ball fired at a wall, a card house, a ladder, dominoes), bounded
# by hand calculations and by what Box2D and Rapier do on the same scenes
# (recorded, not linked). See the source, and physics.md, "Quality beyond
# settling". Tests that found a problem are ignored, each naming its bead.
BEHAVIOUR_SRCS = MEASURE_SRCS + ["behaviour_test.rs"]

rust_test(
    name = "behaviour_test",
    srcs = BEHAVIOUR_SRCS,
    compile_data = BASELINES,
    crate_root = "behaviour_test.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    deps = QUALITY_DEPS,
)

# The edge-of-stability families on their long grids (family.rs): minutes,
# so manual, and meant for -c opt:
#   ./bazel test //engine/std/physics2d/compare:behaviour_long_test
rust_test(
    name = "behaviour_long_test",
    srcs = BEHAVIOUR_SRCS + ["behaviour_long.rs"],
    compile_data = BASELINES,
    crate_features = ["long"],
    crate_root = "behaviour_test.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    tags = ["manual"],
    deps = QUALITY_DEPS,
)

# The baseline's tool (physics-testing.md, "The baseline"; runbook 005):
# every value the baseline records, run and compared with the file, the
# ones that moved past their band printed; --write writes the file.
#   ./bazel run //engine/std/physics2d/compare:baseline [-- --write]
#   ./bazel run //engine/std/physics2d/compare:baseline -- --long [--write]
# The tests that check it are the quality and behaviour tests themselves,
# whose runs it is recorded from (their test "baseline"): a target of its
# own would run every scene a second time.
rust_binary(
    name = "baseline",
    srcs = MEASURE_SRCS + ["baseline_main.rs"],
    compile_data = BASELINES,
    crate_root = "baseline_main.rs",
    data = [":scene_game"],
    env = { "SCENE_GAME": "$(rlocationpath :scene_game)" },
    deps = QUALITY_DEPS,
)

test_suite(
    name = "baseline_test",
    tests = [
        ":behaviour_test",
        ":quality_test",
    ],
)

test_suite(
    name = "baseline_long_test",
    tags = ["manual"],
    tests = [
        ":behaviour_long_test",
        ":quality_long_test",
    ],
)

# The 2D solver alone, on inputs captured from the comparison's turning
# scenes: each way of solving that was weighed, timed on the same work.
#   ./bazel run --config=bench //engine/std/physics2d/compare:solver_bench
rust_binary(
    name = "solver_bench",
    srcs = [
        "ecs.rs",
        "scene.rs",
        "sim.rs",
        "solver_bench.rs",
        "variants.rs",
        "//engine/std/physics2d:narrow.rs",
        "//engine/std/physics2d:solver.rs",
        "//engine/std/physics2d:tests/arrays.rs",
        "//engine/std/physics2d:tests/pool.rs",
        "//engine/std/physics2d:tests/split_impulse.rs",
    ],
    crate_root = "solver_bench.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    deps = QUALITY_DEPS,
)

# The mod's solve and whole step in the engine, on the scenes the flows work
# was measured on: a 10 000 pile falling and settled, a 5050 pyramid.
#   taskset -c 0-7 ./bazel run --config=bench //engine/std/physics2d/compare:step_bench
rust_binary(
    name = "step_bench",
    srcs = [
        "ecs.rs",
        "scene.rs",
        "sim.rs",
        "step_bench.rs",
        "variants.rs",
        "//engine/std/physics2d:narrow.rs",
        "//engine/std/physics2d:solver.rs",
        "//engine/std/physics2d:tests/arrays.rs",
        "//engine/std/physics2d:tests/pool.rs",
        "//engine/std/physics2d:tests/split_impulse.rs",
    ],
    crate_root = "step_bench.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    deps = QUALITY_DEPS,
)

# SPIKE (docs/architecture/parallel-relations.md): colors kept across steps
# against colored afresh, the solve on each, and a solve pass over bodies in
# pages against the copy, measured. Not engine code; kept so the numbers can
# be taken again.
#
#   taskset -c 0-7 ./bazel run --config=bench //engine/std/physics2d/compare:colors_spike
rust_binary(
    name = "colors_spike",
    srcs = [
        "colors_spike.rs",
        "ecs.rs",
        "scene.rs",
        "sim.rs",
        "variants.rs",
        ":colors_spike_srcs",
    ],
    crate_root = "colors_spike.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    tags = ["manual"],
    deps = QUALITY_DEPS,
)

# SPIKE (docs/architecture/working-sets.md): the solve's copy of the bodies
# as built, against an index kept by entity across steps, a slot column and
# derived values kept, on the engine's own world between frames; and what a
# kept index adds to spawning and despawning. Not engine code; kept so the
# numbers can be taken again.
#
#   taskset -c 0-7 ./bazel run --config=bench //engine/std/physics2d/compare:working_set_spike
rust_binary(
    name = "working_set_spike",
    srcs = [
        "ecs.rs",
        "scene.rs",
        "sim.rs",
        "variants.rs",
        "working_set_spike.rs",
        "//engine/std/physics2d:narrow.rs",
        "//engine/std/physics2d:solver.rs",
        "//engine/std/physics2d:tests/arrays.rs",
        "//engine/std/physics2d:tests/pool.rs",
        "//engine/std/physics2d:tests/split_impulse.rs",
    ],
    crate_root = "working_set_spike.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    tags = ["manual"],
    deps = QUALITY_DEPS,
)

# The physics files the spike builds over, copied into this package (a
# generated source moves a crate's sources, and those from another package
# with them go missing), and solver.rs with one line patched: its coloring
# taken from the spike when it hands the solve some (`kept_colors`), so the
# solve can be timed on colors kept across steps. A patch of one line, so
# it can't drift from solver.rs; the grep fails the build if it stops
# applying.
genrule(
    name = "colors_spike_srcs",
    srcs = [
        "//engine/std/physics2d:narrow.rs",
        "//engine/std/physics2d:solver.rs",
        "//engine/std/physics2d:tests/arrays.rs",
        "//engine/std/physics2d:tests/pool.rs",
        "//engine/std/physics2d:tests/split_impulse.rs",
    ],
    outs = [
        "colors_spike_arrays.rs",
        "colors_spike_narrow.rs",
        "colors_spike_pool.rs",
        "colors_spike_solver.rs",
        "colors_spike_split_impulse.rs",
    ],
    cmd = " && ".join([
        "sed 's/let (groups, n_groups) = group(contacts, &moves, params.wide);/let (groups, n_groups) = crate::kept_colors::take().unwrap_or_else(|| group(contacts, \\&moves, params.wide));/' $(location //engine/std/physics2d:solver.rs) > $(location colors_spike_solver.rs)",
        "grep -q kept_colors $(location colors_spike_solver.rs)",
        "cp $(location //engine/std/physics2d:narrow.rs) $(location colors_spike_narrow.rs)",
        "cp $(location //engine/std/physics2d:tests/arrays.rs) $(location colors_spike_arrays.rs)",
        "cp $(location //engine/std/physics2d:tests/pool.rs) $(location colors_spike_pool.rs)",
        "cp $(location //engine/std/physics2d:tests/split_impulse.rs) $(location colors_spike_split_impulse.rs)",
    ]),
    tags = ["manual"],
)

# SPIKE (docs/architecture/flows-spike.md): the solve as a pipeline of
# flows, its passes on a generic colored primitive, against the solve as
# built, on the engine's own world; and the primitive's shapes against the
# hand-tuned staged run. Not engine code; kept so the numbers can be taken
# again.
#
#   taskset -c 0-7 ./bazel run --config=bench //engine/std/physics2d/compare:flows_spike
rust_binary(
    name = "flows_spike",
    srcs = [
        "ecs.rs",
        "flows_physics.rs",
        "flows_spike.rs",
        "scene.rs",
        "sim.rs",
        "variants.rs",
        ":flows_spike_srcs",
    ],
    crate_root = "flows_spike.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    tags = ["manual"],
    deps = QUALITY_DEPS + ["//engine/ecs:flows_spike"],
)

# The pipeline and every shape of the primitive bit for bit the solve as
# built, on small scenes: the spike's claims, kept in the default suite.
rust_test(
    name = "flows_spike_test",
    srcs = [
        "ecs.rs",
        "flows_physics.rs",
        "flows_spike_test.rs",
        "scene.rs",
        "sim.rs",
        "variants.rs",
        ":flows_spike_srcs",
    ],
    crate_root = "flows_spike_test.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    deps = QUALITY_DEPS + ["//engine/ecs:flows_spike"],
)

# As `colors_spike_srcs`, with solver.rs's `lanes` made public and the
# spike's stages (flows_lanes.rs) included there, so they reach the lanes'
# private kernels. One line patched; the grep fails the build if it stops
# applying.
genrule(
    name = "flows_spike_srcs",
    srcs = [
        "flows_lanes.rs",
        "//engine/std/physics2d:narrow.rs",
        "//engine/std/physics2d:solver.rs",
        "//engine/std/physics2d:tests/arrays.rs",
        "//engine/std/physics2d:tests/pool.rs",
        "//engine/std/physics2d:tests/split_impulse.rs",
    ],
    outs = [
        "flows_spike_arrays.rs",
        "flows_spike_lanes.rs",
        "flows_spike_narrow.rs",
        "flows_spike_pool.rs",
        "flows_spike_solver.rs",
        "flows_spike_split_impulse.rs",
    ],
    cmd = " && ".join([
        "sed 's/^mod lanes {/pub mod lanes { include!(\"flows_spike_lanes.rs\");/' $(location //engine/std/physics2d:solver.rs) > $(location flows_spike_solver.rs)",
        "grep -q 'include!(\"flows_spike_lanes.rs\")' $(location flows_spike_solver.rs)",
        "cp $(location flows_lanes.rs) $(location flows_spike_lanes.rs)",
        "cp $(location //engine/std/physics2d:narrow.rs) $(location flows_spike_narrow.rs)",
        "cp $(location //engine/std/physics2d:tests/arrays.rs) $(location flows_spike_arrays.rs)",
        "cp $(location //engine/std/physics2d:tests/pool.rs) $(location flows_spike_pool.rs)",
        "cp $(location //engine/std/physics2d:tests/split_impulse.rs) $(location flows_spike_split_impulse.rs)",
    ]),
)

# SPIKE (docs/architecture/contiguous-columns.md): the solve in place in the
# world's columns, as if each table column were one block, against the copy
# it makes today; and in the world's own pages. Not engine code; kept so the
# numbers can be taken again.
#
#   taskset -c 0-7 ./bazel run --config=bench //engine/std/physics2d/compare:contiguous_spike
rust_binary(
    name = "contiguous_spike",
    srcs = [
        "contiguous_spike.rs",
        "ecs.rs",
        "scene.rs",
        "sim.rs",
        "variants.rs",
        ":contiguous_spike_srcs",
    ],
    crate_root = "contiguous_spike.rs",
    data = [":scene_game"],
    env = {"SCENE_GAME": "$(rlocationpath :scene_game)"},
    tags = ["manual"],
    deps = QUALITY_DEPS,
)

# As `colors_spike_srcs`, with solver.rs's `lanes` made public and given
# the spike's in-place driver (contiguous_lanes.rs), included there so it
# reaches the lanes' private kernels. One line patched; the grep fails the
# build if it stops applying.
genrule(
    name = "contiguous_spike_srcs",
    srcs = [
        "contiguous_lanes.rs",
        "//engine/std/physics2d:narrow.rs",
        "//engine/std/physics2d:solver.rs",
        "//engine/std/physics2d:tests/arrays.rs",
        "//engine/std/physics2d:tests/pool.rs",
        "//engine/std/physics2d:tests/split_impulse.rs",
    ],
    outs = [
        "contiguous_spike_arrays.rs",
        "contiguous_spike_lanes.rs",
        "contiguous_spike_narrow.rs",
        "contiguous_spike_pool.rs",
        "contiguous_spike_solver.rs",
        "contiguous_spike_split_impulse.rs",
    ],
    cmd = " && ".join([
        "sed 's/^mod lanes {/pub mod lanes { include!(\"contiguous_spike_lanes.rs\");/' $(location //engine/std/physics2d:solver.rs) > $(location contiguous_spike_solver.rs)",
        "grep -q 'include!(\"contiguous_spike_lanes.rs\")' $(location contiguous_spike_solver.rs)",
        "cp $(location contiguous_lanes.rs) $(location contiguous_spike_lanes.rs)",
        "cp $(location //engine/std/physics2d:narrow.rs) $(location contiguous_spike_narrow.rs)",
        "cp $(location //engine/std/physics2d:tests/arrays.rs) $(location contiguous_spike_arrays.rs)",
        "cp $(location //engine/std/physics2d:tests/pool.rs) $(location contiguous_spike_pool.rs)",
        "cp $(location //engine/std/physics2d:tests/split_impulse.rs) $(location contiguous_spike_split_impulse.rs)",
    ]),
    tags = ["manual"],
)
