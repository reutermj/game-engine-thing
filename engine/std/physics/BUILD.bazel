load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//engine:defs.bzl", "POISON_ENV", "engine_game", "engine_mod")

# 2D rigid bodies, with every piece of state in the world or this mod's
# state, so the solver hot-reloads under a running simulation. A game uses
# it by naming it in a mod's mod_deps. See docs/architecture/physics.md.

PHYSICS_SRCS = [
    "lib.rs",
    "narrow.rs",
    "sleep.rs",
    "solver.rs",
]

PHYSICS_INTERFACE = [
    "components.rs",
    "shapes.rs",
    "spatial.rs",
]

engine_mod(
    name = "physics",
    srcs = PHYSICS_SRCS,
    twin = True,
    interface = PHYSICS_INTERFACE,
    visibility = ["//visibility:public"],
)

# The same mod under another build name, for the test that swaps the solver
# under a running simulation.
engine_mod(
    name = "physics_v2",
    srcs = PHYSICS_SRCS,
    crate_features = ["v2"],
    interface = PHYSICS_INTERFACE,
    mod_name = "physics",
)

# Test scenes, apart from the demos in //mods: a walled box to drop bodies
# into, and a platformer in miniature. See the sources.
engine_mod(
    name = "pile",
    srcs = ["tests/pile.rs"],
    crate_root = "tests/pile.rs",
    mod_deps = [":physics"],
)

# A pre-solve hook for the pile, apart so the pile the benchmarks run has
# no system of its own.
engine_mod(
    name = "pile_hook",
    srcs = ["tests/hook.rs"],
    crate_root = "tests/hook.rs",
    mod_deps = [":physics"],
)

engine_mod(
    name = "runner",
    srcs = ["tests/runner.rs"],
    crate_root = "tests/runner.rs",
    mod_deps = [":physics"],
)

#   ./bazel run //engine/std/physics:pile_game
#   bazel-bin/engine/modctl/modctl send pile drop 300
#   bazel-bin/engine/modctl/modctl send lockstep step 300
#   bazel-bin/engine/modctl/modctl send pile stats
engine_game(
    name = "pile_game",
    bootstrap = "//engine/std/lockstep",
    mods = [":pile"],
)

engine_game(
    name = "pile_hook_game",
    bootstrap = "//engine/std/lockstep",
    mods = [
        ":pile",
        ":pile_hook",
    ],
)

engine_game(
    name = "runner_game",
    bootstrap = "//engine/std/lockstep",
    mods = [":runner"],
)

# The shapes' tests, in the interface crate.
rust_test(
    name = "shapes_test",
    crate = ":physics_interface",
)

# The narrowphase and solver alone, and whole steps over arrays.
rust_test(
    name = "core_test",
    srcs = [
        "narrow.rs",
        "solver.rs",
        "tests/core_test.rs",
    ],
    crate_root = "tests/core_test.rs",
    deps = [":physics_interface"],
)

# Spatial queries on a world driven by the ECS harness, without the loader.
rust_test(
    name = "spatial_test",
    srcs = ["tests/spatial_test.rs"],
    deps = [
        ":physics_interface",
        "//engine/api",
        "//engine/ecs",
    ],
)

TEST_DATA = {
    "PILE": ":pile_game",
    "PILE_HOOK": ":pile_hook_game",
    "RUNNER": ":runner_game",
    "PHYSICS_V2": ":physics_v2",
}

# The mod in a running engine, on the test scenes.
rust_test(
    name = "physics_test",
    srcs = [
        "tests/physics_test.rs",
        "tests/pool.rs",
    ],
    crate_root = "tests/physics_test.rs",
    data = TEST_DATA.values(),
    env = {var: "$(rlocationpath %s)" % target for var, target in TEST_DATA.items()} | POISON_ENV,
    deps = [
        ":physics_interface",
        "//engine/control",
        "//engine/ecs",
        "//engine/loader",
        "@rules_rust//rust/runfiles",
    ],
)

#   ./bazel run -c opt //engine/std/physics:bench
rust_binary(
    name = "bench",
    srcs = ["tests/bench.rs"],
    data = [":pile_game"],
    env = {"PILE": "$(rlocationpath :pile_game)"},
    deps = [
        "//engine/control",
        "//engine/loader",
        "@rules_rust//rust/runfiles",
    ],
)

# The ECS's cost over the same step on plain arrays, checked to be the same
# computation bit for bit:
#   ./bazel run -c opt //engine/std/physics:tax
# and split across 1 to 16 threads, each checked bit for bit against one
# (REPS and THREADS=1,2,.. in the environment override the defaults;
# STICKY, SPIN_US and TASK_ALLOC change the pool and the arrays' lists: see
# tests/pool.rs and tests/tax_par.rs):
#   ./bazel run -c opt //engine/std/physics:tax -- parallel
rust_binary(
    name = "tax",
    srcs = [
        "narrow.rs",
        "solver.rs",
        "tests/arrays.rs",
        "tests/pool.rs",
        "tests/tax.rs",
        "tests/tax_par.rs",
    ],
    crate_root = "tests/tax.rs",
    data = [":pile_game"],
    env = {"PILE": "$(rlocationpath :pile_game)"},
    deps = [
        ":physics_interface",
        "//engine/control",
        "//engine/ecs",
        "//engine/loader",
    ],
)

# Why `solve` copies bodies out of the world: the same solve over the same
# pile's contacts with bodies kept each way (layout, pages, derived inverse
# mass, order, in the world's own pages), each checked bit for bit:
#   ./bazel run -c opt //engine/std/physics:solver_layout
rust_binary(
    name = "solver_layout",
    srcs = [
        "solver.rs",
        "tests/solver_layout.rs",
    ],
    crate_root = "tests/solver_layout.rs",
    data = [":pile_game"],
    env = {"PILE": "$(rlocationpath :pile_game)"},
    deps = [
        ":physics_interface",
        "//engine/control",
        "//engine/ecs",
        "//engine/loader",
    ],
)

# How far the solver parallelizes: sequential impulses over graph colors
# and over islands, on 1 to 32 threads, against `solver::solve`, over a
# 10 000 pile's contacts and a scene of separate stacks; checked bit for
# bit across thread counts, and for how well the pile settles:
#   ./bazel run -c opt //engine/std/physics:parallel_solver
rust_binary(
    name = "parallel_solver",
    srcs = [
        "narrow.rs",
        "solver.rs",
        "tests/arrays.rs",
        "tests/parallel_solver.rs",
    ],
    crate_root = "tests/parallel_solver.rs",
    data = [":pile_game"],
    env = {"PILE": "$(rlocationpath :pile_game)"},
    deps = [
        ":physics_interface",
        "//engine/control",
        "//engine/ecs",
        "//engine/loader",
    ],
)
