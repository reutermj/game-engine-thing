load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load(":miri.bzl", "ecs_miri_test")

# The ECS the loader and every mod share, as Rust types. See lib.rs.
rust_library(
    name = "ecs",
    srcs = [
        "between.rs",
        "component.rs",
        "erased.rs",
        "events.rs",
        "graph.rs",
        "harness.rs",
        "lib.rs",
        "ordered.rs",
        "par.rs",
        "query.rs",
        "schema.rs",
        "spatial.rs",
        "world.rs",
    ],
    crate_name = "engine_ecs",
    crate_root = "lib.rs",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "ecs_test",
    crate = ":ecs",
)

# The walkthrough's scenario (docs/architecture/storage.md), for the tests
# and the benchmark.
rust_library(
    name = "game",
    testonly = True,
    srcs = ["tests/game.rs"],
    crate_name = "ecs_game",
    crate_root = "tests/game.rs",
    deps = [":ecs"],
)

# Operation sequences against trivially correct models: the driver the
# model test, the fuzzers (//engine/ecs/fuzz) and the replays share.
rust_library(
    name = "ops",
    testonly = True,
    srcs = ["tests/ops.rs"],
    crate_name = "ecs_ops",
    crate_root = "tests/ops.rs",
    visibility = ["//engine/ecs/fuzz:__pkg__"],
    deps = [":ecs"],
)

# The storage against a trivially correct model, under random changes.
rust_test(
    name = "model_test",
    srcs = ["tests/model_test.rs"],
    deps = [":ops"],
)

# The graph and the query API, on the scenario and small cases.
rust_test(
    name = "graph_test",
    srcs = ["tests/graph_test.rs"],
    deps = [
        ":ecs",
        ":game",
    ],
)

# Components across builds, events, and the world between frames.
rust_test(
    name = "world_test",
    srcs = ["tests/world_test.rs"],
    deps = [":ecs"],
)

# Frame times and timelines for the game scenario, sequential and parallel:
# `./bazel run -c opt //engine/ecs:bench`, with `WORK=0` for the framework's
# own cost. Test-only because the scenario is.
rust_binary(
    name = "bench",
    testonly = True,
    srcs = ["bench.rs"],
    deps = [
        ":ecs",
        ":game",
    ],
)

# Spatial tables against brute force, and in the scheduler.
rust_test(
    name = "spatial_test",
    srcs = ["tests/spatial_test.rs"],
    deps = [":ecs"],
)

#   ./bazel run -c opt //engine/ecs:spatial_bench
rust_binary(
    name = "spatial_bench",
    srcs = ["tests/spatial_bench.rs"],
    deps = [":ecs"],
)

# Ordered tables: key order kept through every change, walks by key.
rust_test(
    name = "ordered_test",
    srcs = ["tests/ordered_test.rs"],
    deps = [":ecs"],
)

# Page walks and table walks against brute force, and what their writes
# stamp.
rust_test(
    name = "page_test",
    srcs = ["tests/page_test.rs"],
    deps = [":ecs"],
)

# A query's cost per row, by how it's walked:
#   ./bazel run -c opt //engine/ecs:query_bench
rust_binary(
    name = "query_bench",
    srcs = ["tests/query_bench.rs"],
    deps = [":ecs"],
)

# Miri: the crate's own tests, and the integration tests that drive the
# unsafe core, under each aliasing model. Manual, since they take minutes:
#   ./bazel test //engine/ecs:miri
# The tests shrink their inputs under `cfg(miri)`, and skip what's too slow
# interpreted (docs/runbooks/002-run-miri-and-fuzz-the-core.md).
MIRI_TESTS = ecs_miri_test(
    name = "miri_unit",
    srcs = glob(
        ["*.rs"],
        exclude = ["bench.rs"],
    ),
    crate_name = "engine_ecs",
    crate_root = "lib.rs",
) + [
    test
    for name in [
        "model_test",
        "world_test",
        "spatial_test",
        "ordered_test",
        "page_test",
    ]
    for test in ecs_miri_test(
        name = "miri_" + name,
        srcs = ["tests/{}.rs".format(name)],
        crate_name = name,
        crate_root = "tests/{}.rs".format(name),
        deps = [
            ":ecs",
            ":ops",
        ],
    )
]

test_suite(
    name = "miri",
    tags = ["manual"],
    tests = MIRI_TESTS,
)
