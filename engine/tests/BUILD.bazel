load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//engine:defs.bzl", "engine_game", "engine_mod")

# Test mods live here, apart from the demo mods in //mods, so editing a demo
# never changes what a test proves.

rust_library(
    name = "probe",
    srcs = ["probe.rs"],
    crate_name = "test_probe",
    deps = ["//engine/api"],
)

# A bootstrap shaped like a windowing library's event loop. See mods/fake_os.rs.
engine_mod(
    name = "fake_os",
    srcs = ["mods/fake_os.rs"],
    crate_root = "mods/fake_os.rs",
    resident = True,
)

# Builds of the one mod `counter`. See mods/counter.rs.
COUNTER_BUILDS = [
    "v1",
    "v2",
    "v3",
    "v4",
    "panic",
]

[engine_mod(
    name = "counter_" + build,
    srcs = ["mods/counter.rs"],
    crate_features = [build],
    crate_root = "mods/counter.rs",
    mod_name = "counter",
    deps = [":probe"],
) for build in COUNTER_BUILDS]

[engine_mod(
    name = "mover_" + build,
    srcs = ["mods/mover.rs"],
    crate_features = [build],
    crate_root = "mods/mover.rs",
    mod_name = "mover",
) for build in [
    "v1",
    "v2",
]]

# Builds of `base`, and of `user`, which depends on it. See mods/base.rs.
[engine_mod(
    name = "base_" + build,
    srcs = ["mods/base.rs"],
    crate_features = [build],
    crate_root = "mods/base.rs",
    interface = ["mods/base_interface_%s.rs" % interface],
    mod_name = "base",
) for build, interface in [
    ("v1", "v1"),
    ("v1b", "v1"),
    ("v2", "v2"),
]]

[engine_mod(
    name = "user_" + build,
    srcs = ["mods/user.rs"],
    crate_root = "mods/user.rs",
    mod_deps = [":base_" + build],
    mod_name = "user",
) for build in [
    "v1",
    "v2",
]]

# Builds of `bag`, which keeps heap data in the world. See mods/bag.rs.
[engine_mod(
    name = "bag_" + build,
    srcs = ["mods/bag.rs"],
    crate_features = [build],
    crate_root = "mods/bag.rs",
    mod_name = "bag",
) for build in [
    "v1",
    "v2",
    "v3",
]]

# Builds of `greeter`, whose state points into its own library: the case the
# restriction on mod state exists for. See mods/greeter.rs.
[engine_mod(
    name = "greeter_" + variant + build,
    srcs = ["mods/greeter.rs"],
    crate_features = [build] + features,
    crate_root = "mods/greeter.rs",
    mod_name = "greeter",
) for build in [
    "v1",
    "v2",
] for variant, features in [
    ("", []),
    ("right_", ["right"]),
]]

# Builds of `calc`, which provides a service, and `caller`, which calls it.
# See mods/calc.rs.
[engine_mod(
    name = "calc_" + build,
    srcs = ["mods/calc.rs"],
    crate_features = [build],
    crate_root = "mods/calc.rs",
    interface = ["mods/calc_interface.rs"],
    mod_name = "calc",
) for build in [
    "v1",
    "v2",
]]

engine_mod(
    name = "caller",
    srcs = ["mods/caller.rs"],
    crate_root = "mods/caller.rs",
    mod_deps = [":calc_v1"],
)

# Builds of `vault`, a resident mod that owns a thread, and `teller`, which
# calls it. See mods/vault.rs.
[engine_mod(
    name = "vault_" + build,
    srcs = ["mods/vault.rs"],
    crate_features = [build],
    crate_root = "mods/vault.rs",
    interface = ["mods/vault_interface.rs"],
    mod_name = "vault",
    resident = True,
) for build in [
    "v1",
    "v2",
]]

engine_mod(
    name = "teller",
    srcs = ["mods/teller.rs"],
    crate_root = "mods/teller.rs",
    mod_deps = [":vault_v1"],
)

# Resident builds of `base` and `user`. A resident mod's mod_deps must be
# resident too, so user_resident depends on base_resident, whose interface is
# base_v1's: loading it against the reloadable base_v1 is what the loader's
# own check refuses.
engine_mod(
    name = "base_resident",
    srcs = ["mods/base.rs"],
    crate_features = ["v1"],
    crate_root = "mods/base.rs",
    interface = ["mods/base_interface_v1.rs"],
    mod_name = "base",
    resident = True,
)

engine_mod(
    name = "user_resident",
    srcs = ["mods/user.rs"],
    crate_root = "mods/user.rs",
    mod_deps = [":base_resident"],
    mod_name = "user",
    resident = True,
)

engine_mod(
    name = "no_entry",
    srcs = ["mods/no_entry.rs"],
    crate_root = "mods/no_entry.rs",
)

engine_mod(
    name = "wrong_api",
    srcs = ["mods/wrong_api.rs"],
    crate_root = "mods/wrong_api.rs",
)

TEST_MODS = {
    "VAULT_V1": ":vault_v1",
    "VAULT_V2": ":vault_v2",
    "TELLER": ":teller",
    "BASE_RESIDENT": ":base_resident",
    "USER_RESIDENT": ":user_resident",
    "CALC_V1": ":calc_v1",
    "CALC_V2": ":calc_v2",
    "CALLER": ":caller",
    "GREETER_V1": ":greeter_v1",
    "GREETER_V2": ":greeter_v2",
    "GREETER_RIGHT_V1": ":greeter_right_v1",
    "GREETER_RIGHT_V2": ":greeter_right_v2",
    "BAG_V1": ":bag_v1",
    "BAG_V2": ":bag_v2",
    "BAG_V3": ":bag_v3",
    # The real ones: the lockstep bootstrap is what exercises a message
    # handler that steps other mods.
    "CLOCK": "//mods/clock",
    "LOCKSTEP": "//mods/lockstep",
    "BASE_V1": ":base_v1",
    "BASE_V1B": ":base_v1b",
    "BASE_V2": ":base_v2",
    "USER_V1": ":user_v1",
    "USER_V2": ":user_v2",
    "FAKE_OS": ":fake_os",
    "MOVER_V1": ":mover_v1",
    "MOVER_V2": ":mover_v2",
    "NO_ENTRY": ":no_entry",
    "WRONG_API": ":wrong_api",
} | {
    "COUNTER_" + build.upper(): ":counter_" + build
    for build in COUNTER_BUILDS
}

rust_test(
    name = "reload_test",
    srcs = ["reload_test.rs"],
    data = TEST_MODS.values(),
    env = {var: "$(rlocationpath %s)" % target for var, target in TEST_MODS.items()},
    deps = [
        ":probe",
        "//engine/api",
        "//engine/control",
        "//engine/loader",
        "@rules_rust//rust/runfiles",
    ],
)

# The real bootstrap mod (with frame pacing) and test mods, as a game. `base`
# isn't listed: it comes in as `user`'s dependency.
engine_game(
    name = "test_game",
    bootstrap = "//mods/bootstrap",
    mods = [
        ":counter_v1",
        ":user_v1",
    ],
)

# The same game with counter_v2: its manifest is what the reload target of
# test_game would send after counter's source changed to v2.
engine_game(
    name = "test_game_v2",
    bootstrap = "//mods/bootstrap",
    mods = [
        ":counter_v2",
        ":user_v1",
    ],
)

E2E_DATA = {
    "BASE_V2": ":base_v2",
    "COUNTER_V2": ":counter_v2",
    "MANIFEST_V2": ":test_game_v2",
    "ENGINE": "//engine/loader:engine",
    # The engine_game target's output is its manifest.
    "MANIFEST": ":test_game",
    "MODCTL": "//engine/modctl",
}

rust_test(
    name = "e2e_test",
    srcs = ["e2e_test.rs"],
    data = E2E_DATA.values(),
    env = {var: "$(rlocationpath %s)" % target for var, target in E2E_DATA.items()},
    deps = ["@rules_rust//rust/runfiles"],
)
