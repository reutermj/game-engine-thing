load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "api",
    srcs = [
        "lib.rs",
        "scheduler.rs",
        "service.rs",
        "system.rs",
    ],
    crate_name = "engine_api",
    lint_config = "//engine:mod_lints",
    crate_root = "lib.rs",
    visibility = ["//visibility:public"],
    deps = ["//engine/ecs"],
)

rust_test(
    name = "api_test",
    crate = ":api",
)
