load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_library(
    name = "api",
    srcs = [
        "lib.rs",
        "scheduler.rs",
        "service.rs",
        "system.rs",
    ],
    crate_name = "engine_api",
    lint_config = "//engine:mod_lints",
    crate_root = "lib.rs",
    visibility = ["//visibility:public"],
    deps = ["//engine/ecs"],
)

rust_test(
    name = "api_test",
    crate = ":api",
)

# Service signatures service! must refuse (get-y5t.9), as doctests that must
# fail to compile beside twins that must compile: see the source. A crate of
# its own so the cases don't crowd service!'s documentation.
rust_library(
    name = "crossing_cases",
    testonly = True,
    srcs = ["tests/crossing_cases.rs"],
    crate_root = "tests/crossing_cases.rs",
    deps = [":api"],
)

rust_doc_test(
    name = "crossing_test",
    crate = ":crossing_cases",
)
