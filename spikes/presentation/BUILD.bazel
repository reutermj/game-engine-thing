# SPIKE (get-3hd.1): the presentation spike, wgpu, winit and tiny-skia
# under Bazel, the loop, per-library statics, extract and draw costs.
# Findings in docs/architecture/presentation-spike.md; delete this package
# once presentation.md's decisions are made (CLAUDE.md, "Spikes are
# throwaway"). Every target is manual: they need a GPU, a display or
# minutes of wgpu compile that `./bazel test //...` shouldn't pay.

load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("//engine:defs.bzl", "engine_game", "engine_mod")

# ---- The mods ----

# The extract, and the vocabulary (`Place`, `Look`, the `DrawList` flow).
engine_mod(
    name = "spike_draw",
    srcs = ["draw.rs"],
    crate_root = "draw.rs",
    interface = ["draw_interface.rs"],
    tags = ["manual"],
)

# The game: drawables that move. Two builds that move them differently,
# under one mod name, so a reload shows:
#   ./bazel run //spikes/presentation:spike_scene_b
[engine_mod(
    name = name,
    srcs = ["scene.rs"],
    crate_features = features,
    crate_root = "scene.rs",
    mod_deps = [":spike_draw"],
    mod_name = "spike_scene",
    tags = ["manual"],
) for name, features in [
    ("spike_scene", []),
    ("spike_scene_b", ["b"]),
]]

# A presenter without a GPU: reads the draw list and copies it.
engine_mod(
    name = "spike_sink",
    srcs = ["sink.rs"],
    crate_root = "sink.rs",
    mod_deps = [":spike_draw"],
    tags = ["manual"],
)

# The platform: winit's event loop and the window, resident.
engine_mod(
    name = "spike_platform",
    srcs = ["platform.rs"],
    crate_root = "platform.rs",
    interface = ["platform_interface.rs"],
    resident = True,
    tags = ["manual"],
    deps = [
        ":gfx",
        "@crates//:winit",
    ],
)

# The realtime bootstrap, pumping the platform's window once a frame.
engine_mod(
    name = "spike_windowed",
    srcs = ["windowed.rs"],
    crate_root = "windowed.rs",
    mod_deps = [
        ":spike_platform",
        "//engine/std/clock",
    ],
    resident = True,
    tags = ["manual"],
)

# The window presenter, reloadable.
engine_mod(
    name = "spike_present",
    srcs = ["present.rs"],
    crate_root = "present.rs",
    mod_deps = [
        ":spike_draw",
        ":spike_platform",
    ],
    tags = ["manual"],
    deps = [
        ":gfx",
        "@crates//:pollster",
        "@crates//:wgpu",
    ],
)

# A window showing the scene, which reloads under it:
#   ./bazel run //spikes/presentation:window_game
#   bazel-bin/engine/modctl/modctl send spike_scene spawn 10000
#   ./bazel run //spikes/presentation:spike_scene_b     (or :spike_present)
engine_game(
    name = "window_game",
    bootstrap = ":spike_windowed",
    mods = [
        ":spike_scene",
        ":spike_draw",
        ":spike_present",
    ],
    tags = ["manual"],
)

# ---- Pong with a spectator window (the spike's finale) ----

# Pong drawn in the spike's vocabulary: reads pong's components, adds rects
# to the frame's draw list, and the turn barrier's status (restaged between
# frames). Pong itself doesn't change.
engine_mod(
    name = "spike_pong_view",
    srcs = ["pong_view.rs"],
    crate_root = "pong_view.rs",
    mod_deps = [
        ":spike_draw",
        ":spike_turns",
        "//engine/std/clock",
        "//engine/std/physics2d",
        "//pong/core",
    ],
    tags = ["manual"],
)

# Lockstep (mod name `lockstep`, so agents drive it the same way) with the
# window pumped while idle and a step's frames paced in real time.
engine_mod(
    name = "spike_lockstep_window",
    srcs = ["lockstep_window.rs"],
    crate_root = "lockstep_window.rs",
    mod_deps = [
        ":spike_platform",
        ":spike_record",
        ":spike_turns",
        "//engine/std/clock",
    ],
    mod_name = "lockstep",
    resident = True,
    tags = ["manual"],
)

# Pong in lockstep, shown in a window: what an agent plays and a person
# watches. Start it with :pong_window_launch, which sets the socket.
engine_game(
    name = "pong_window",
    bootstrap = ":spike_lockstep_window",
    mods = [
        "//pong/ai",
        "//pong/text",
        ":spike_pong_record",
        ":spike_draw",
        ":spike_pong_view",
        ":spike_present",
    ],
    tags = ["manual"],
)

# The launcher: `./bazel run //spikes/presentation:pong_window_launch`
# starts :pong_window on /run/user/1000/pong-window/control.sock and prints
# an agent's commands (AGENT.md).
rust_binary(
    name = "pong_window_launch",
    srcs = ["pong_launch.rs"],
    data = [
        ":pong_window",
        "//engine/loader:engine",
        "//engine/modctl",
    ],
    env = {
        "PONG_ENGINE": "$(rlocationpath //engine/loader:engine)",
        "PONG_MANIFEST": "$(rlocationpath :pong_window)",
    },
    tags = ["manual"],
)

# ---- Two agents against each other, in turns ----

# The turn barrier's data (`Turn`, `Outcome`), which the bootstrap
# publishes and the game reads. Resident, like clock, since the bootstrap
# depends on it.
engine_mod(
    name = "spike_turns",
    srcs = ["turns.rs"],
    crate_root = "turns.rs",
    interface = ["turns_interface.rs"],
    resident = True,
    tags = ["manual"],
)

# The game's side of the barrier: both paddles steered from the turn's
# actions, a point limit, and `state`/`show` naming both sides.
engine_mod(
    name = "spike_pong_versus",
    srcs = ["pong_versus.rs"],
    crate_root = "pong_versus.rs",
    mod_deps = [
        ":spike_turns",
        "//engine/std/clock",
        "//engine/std/physics2d",
        "//pong/core",
    ],
    mod_name = "pong_versus",
    tags = ["manual"],
)

# Pong for two agents, no AI, on the windowed lockstep bootstrap in turns
# (SPIKE_TURNS, set by the launcher). AGENT_VERSUS.md.
engine_game(
    name = "pong_versus",
    bootstrap = ":spike_lockstep_window",
    mods = [
        ":spike_pong_versus",
        ":spike_pong_record",
        ":spike_draw",
        ":spike_pong_view",
        ":spike_present",
    ],
    tags = ["manual"],
)

# `./bazel run //spikes/presentation:pong_versus_launch` starts
# :pong_versus on /run/user/1000/pong-versus/control.sock, in turns of 6
# frames (PONG_TURN_FRAMES).
rust_binary(
    name = "pong_versus_launch",
    srcs = ["pong_launch.rs"],
    crate_root = "pong_launch.rs",
    data = [
        ":pong_versus",
        "//engine/loader:engine",
        "//engine/modctl",
    ],
    env = {
        "PONG_ENGINE": "$(rlocationpath //engine/loader:engine)",
        "PONG_MANIFEST": "$(rlocationpath :pong_versus)",
        "PONG_VERSUS": "1",
    },
    tags = ["manual"],
)

# ---- The playtest loop: record, replay, probe, flag (REVIEW.md) ----

# What the recorder sees of a game (`Watch`), which the bootstrap reads
# after every frame and writes to the session log. Resident, like
# spike_turns, since the bootstrap depends on it.
engine_mod(
    name = "spike_record",
    srcs = ["record.rs"],
    crate_root = "record.rs",
    interface = ["record_interface.rs"],
    resident = True,
    tags = ["manual"],
)

# Pong's side of the recorder: fills the `Watch` each frame. In both
# windowed games and both replay games.
engine_mod(
    name = "spike_pong_record",
    srcs = ["pong_record.rs"],
    crate_root = "pong_record.rs",
    mod_deps = [
        ":spike_record",
        "//engine/std/clock",
        "//engine/std/physics2d",
        "//pong/core",
    ],
    mod_name = "pong_record",
    tags = ["manual"],
)

# A presenter that hands the last draw list out as text, for the replay
# tool to rasterise: the replay games load it where the windowed ones load
# spike_present.
engine_mod(
    name = "spike_capture",
    srcs = ["capture.rs"],
    crate_root = "capture.rs",
    mod_deps = [":spike_draw"],
    tags = ["manual"],
)

# The windowed games without a window: the same bootstrap and mods, with
# spike_capture for spike_present, and no display (the replay tool hides
# it, so spike_platform makes no window).
[engine_game(
    name = name,
    bootstrap = ":spike_lockstep_window",
    mods = mods + [
        ":spike_pong_record",
        ":spike_draw",
        ":spike_pong_view",
        ":spike_capture",
    ],
    tags = ["manual"],
) for name, mods in [
    ("pong_window_replay", [
        "//pong/ai",
        "//pong/text",
    ]),
    ("pong_versus_replay", [":spike_pong_versus"]),
]]

# //pong itself (the standard lockstep, pong_ai, pong_text: no recorder,
# view or presenter), for `pong_replay --plain`: a one-player session that
# reproduces on it too was played by the same game the spike recorded.
engine_game(
    name = "pong_plain_replay",
    bootstrap = "//engine/std/lockstep",
    mods = [
        "//pong/ai",
        "//pong/text",
    ],
    tags = ["manual"],
)

# Replays a recorded session headless, checks it reproduces, and writes
# probes, flags and frames (REVIEW.md):
#   ./bazel run //spikes/presentation:pong_replay -- <session.jsonl> [--frames N..M]
rust_binary(
    name = "pong_replay",
    srcs = ["pong_replay.rs"],
    data = [
        ":pong_plain_replay",
        ":pong_versus_replay",
        ":pong_window_replay",
    ],
    env = {
        "PONG_PLAIN_REPLAY": "$(rlocationpath :pong_plain_replay)",
        "PONG_VERSUS_REPLAY": "$(rlocationpath :pong_versus_replay)",
        "PONG_WINDOW_REPLAY": "$(rlocationpath :pong_window_replay)",
    },
    tags = ["manual"],
    deps = [
        ":spike_record_interface",
        "//engine/api",
        "//engine/control",
        "//engine/loader",
        "//engine/std/physics2d:physics2d_interface",
        "//pong/core:core_interface",
        "@crates//:tiny-skia",
    ],
)

# The extract and the hand-off without a GPU, in lockstep, for the bench.
engine_game(
    name = "extract_game",
    bootstrap = "//engine/std/lockstep",
    mods = [
        ":spike_scene",
        ":spike_draw",
        ":spike_sink",
    ],
    tags = ["manual"],
)

# The extract's cost, full against incremental against delta, at 1k, 10k
# and 100k drawables with 1, 10 and 100% of them moving a frame:
#   ./bazel run --config=bench //spikes/presentation:extract_bench
rust_binary(
    name = "extract_bench",
    srcs = ["extract_bench.rs"],
    data = [":extract_game"],
    env = {"EXTRACT_GAME": "$(rlocationpath :extract_game)"},
    tags = ["manual"],
    deps = [
        "//engine/control",
        "//engine/loader",
    ],
)

# ---- Standalone ----

# The draw item and a wgpu renderer for it, shared by the draw bench and
# the presenter mod.
rust_library(
    name = "gfx",
    srcs = ["gfx.rs"],
    crate_name = "presentation_gfx",
    crate_root = "gfx.rs",
    tags = ["manual"],
    deps = [
        "@crates//:bytemuck",
        "@crates//:pollster",
        "@crates//:wgpu",
    ],
)

# Draw throughput, a draw per item against instanced by material:
#   ./bazel run --config=bench //spikes/presentation:draw_bench
#   SPIKE_ADAPTER=llvmpipe ./bazel run --config=bench //spikes/presentation:draw_bench
rust_binary(
    name = "draw_bench",
    srcs = ["draw_bench.rs"],
    tags = ["manual"],
    deps = [
        ":gfx",
        "@crates//:pollster",
        "@crates//:wgpu",
    ],
)

# tiny-skia rasterising the same shapes on one thread:
#   ./bazel run --config=bench //spikes/presentation:skia_bench
rust_binary(
    name = "skia_bench",
    srcs = ["skia_bench.rs"],
    tags = ["manual"],
    deps = [
        ":gfx",
        "@crates//:tiny-skia",
    ],
)

# Lists the Vulkan adapters and times device creation on each.
#   ./bazel run //spikes/presentation:probe
rust_binary(
    name = "probe",
    srcs = ["probe.rs"],
    tags = ["manual"],
    deps = [
        "@crates//:pollster",
        "@crates//:wgpu",
    ],
)
