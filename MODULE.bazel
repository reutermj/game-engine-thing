module(name = "game_engine_thing")

bazel_dep(name = "rules_rs", version = "0.0.111")
bazel_dep(name = "llvm", version = "0.8.23")
bazel_dep(name = "platforms", version = "1.1.0")

# For the fuzzers (//engine/ecs/fuzz): libFuzzer as a C++ library, and a
# transition that instruments every Rust crate in a fuzz binary. Both are
# already in the graph, at these versions, through rules_rs and llvm.
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "with_cfg.bzl", version = "0.12.0")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.98.1",
)
# Miri, for the unsafe core's tests only (//engine/ecs:miri_*): its own
# nightly toolchain types, so the stable toolchain above stays the one
# everything else builds with. See docs/runbooks/002-run-miri-and-fuzz-the-core.md.
toolchains.experimental_miri(version = "nightly/2026-09-20")
use_repo(toolchains, "default_rust_toolchains", "miri_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    "@miri_toolchains//:all",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

# Box2D v3, the reference C engine, for //engine/std/physics/compare only:
# the latest release (3.1.1, 2025-06-04), pinned by checksum so a comparison
# is of the same code on every run. Built as a cc_library with the hermetic
# llvm toolchain; see engine/std/physics/compare/box2d.BUILD.bazel.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "box2d",
    build_file = "//engine/std/physics/compare:box2d.BUILD.bazel",
    sha256 = "fb6ef914b50f4312d7d921a600eabc12318bb3c55a0b8c0b90608fa4488ef2e4",
    strip_prefix = "box2d-3.1.1",
    urls = ["https://github.com/erincatto/box2d/archive/refs/tags/v3.1.1.tar.gz"],
)
