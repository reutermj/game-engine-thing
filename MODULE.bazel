module(name = "game_engine_thing")

bazel_dep(name = "rules_rs", version = "0.0.111")
bazel_dep(name = "llvm", version = "0.8.23")
bazel_dep(name = "platforms", version = "1.1.0")

# For the fuzzers (//engine/ecs/fuzz): libFuzzer as a C++ library, and a
# transition that instruments every Rust crate in a fuzz binary. Both are
# already in the graph, at these versions, through rules_rs and llvm.
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "with_cfg.bzl", version = "0.12.0")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.98.1",
)
# Miri, for the unsafe core's tests only (//engine/ecs:miri_*): its own
# nightly toolchain types, so the stable toolchain above stays the one
# everything else builds with. See docs/runbooks/002-run-miri-and-fuzz-the-core.md.
toolchains.experimental_miri(version = "nightly/2026-09-20")
use_repo(toolchains, "default_rust_toolchains", "miri_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    "@miri_toolchains//:all",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

# --- physics3d spike: engines for //bench/physics3d (begin) ---
# Jolt and Box3D are built from source with the hermetic llvm toolchain; the
# BUILD files are ours, since both ship only CMake. Rapier comes from
# crates.io (bench/physics3d/Cargo.toml), but its crate carries no LICENSE,
# so the Apache-2.0 text is fetched from the matching tag.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name = "jolt",
    build_file = "//bench/physics3d:jolt.BUILD",
    sha256 = "6e069ee0172478cc78182047aac87e5310ba14a67a53348ae14cc37801fd3f8e",
    strip_prefix = "JoltPhysics-5.6.0",
    urls = ["https://github.com/jrouwe/JoltPhysics/archive/refs/tags/v5.6.0.tar.gz"],
)

http_archive(
    name = "box3d",
    build_file = "//bench/physics3d:box3d.BUILD",
    sha256 = "df232c7618c0d0d3927b798044559ee56eabadeb9d8ff9dc526d4b384d7b415d",
    strip_prefix = "box3d-0.1.0",
    urls = ["https://github.com/erincatto/box3d/archive/refs/tags/v0.1.0.tar.gz"],
)

http_file(
    name = "rapier_license",
    downloaded_file_path = "LICENSE",
    sha256 = "ceacfa4d7fa67df64ab09a56fe248c50a3bfc9bc00374d69bd74ad763b14b89c",
    urls = ["https://raw.githubusercontent.com/dimforge/rapier/v0.36.0/LICENSE"],
)
# --- physics3d spike: engines for //bench/physics3d (end) ---
