load("//engine:defs.bzl", "engine_mod")

# Resident, like every bootstrap: it runs the frame loop, so it is on the
# stack whenever the loader swaps builds.
engine_mod(
    name = "bootstrap",
    srcs = ["lib.rs"],
    mod_deps = ["//mods/clock"],
    resident = True,
    visibility = ["//visibility:public"],
)
