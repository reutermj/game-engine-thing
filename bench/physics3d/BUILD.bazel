# A comparison harness for 3D rigid-body physics: the same scenes and the same
# quality measures over Rapier 3D, Jolt and Box3D, all single-threaded, bodies
# turning or locked. See lib.rs's module docs; main.rs for the command line.
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load(":copts.bzl", "BOX3D_COPTS", "JOLT_COPTS")

exports_files([
    "jolt.BUILD",
    "box3d.BUILD",
])

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

# --define=jolt_simd=sse2 builds Jolt for baseline x86-64, as rustc builds
# the Rust engines; the default is Jolt's own CMake default, AVX2.
config_setting(
    name = "jolt_simd_sse2",
    define_values = {"jolt_simd": "sse2"},
)

cc_library(
    name = "jolt_shim",
    srcs = ["jolt_shim.cpp"],
    hdrs = ["shim.h"],
    copts = JOLT_COPTS,
    deps = ["@jolt"],
)

cc_library(
    name = "box3d_shim",
    srcs = ["box3d_shim.c"],
    hdrs = ["shim.h"],
    copts = BOX3D_COPTS,
    deps = ["@box3d"],
)

# The licences of everything the bench binary links, shipped in its runfiles.
filegroup(
    name = "licenses",
    srcs = [
        "@box3d//:LICENSE",
        "@jolt//:LICENSE",
        "@rapier_license//file",
    ],
)

rust_library(
    name = "physics3d",
    srcs = [
        "behave.rs",
        "bounces.rs",
        "box3d.rs",
        "ffi.rs",
        "jolt.rs",
        "lib.rs",
        "measure.rs",
        "ours.rs",
        "rapier.rs",
        "record.rs",
        "runs.rs",
        "//engine/std/physics/compare:baseline.rs",
        "//engine/std/physics3d:tests/scenes.rs",
    ],
    # The baseline (record.rs), built in for the tests to check.
    compile_data = [
        "baseline.txt",
        "baseline_long.txt",
    ],
    crate_name = "physics3d_bench",
    # Ours is the physics3d mod in the engine, on pile3d's scenes.
    data = [
        ":licenses",
        "//engine/std/physics3d:pile3d_game",
    ],
    rustc_env = {"PILE3D": "$(rlocationpath //engine/std/physics3d:pile3d_game)"},
    deps = [
        ":box3d_shim",
        ":jolt_shim",
        "//engine/control",
        "//engine/ecs",
        "//engine/loader",
        "//engine/std/physics3d:physics3d_interface",
        "@crates//:rapier3d",
    ],
)

rust_binary(
    name = "bench",
    srcs = ["main.rs"],
    data = [":licenses"],
    deps = [":physics3d"],
)

# The baseline's tool, 2D's for 3D (physics-testing.md, "The baseline";
# runbook 005): every value the baseline records, compared with the file;
# --write writes it. The quality and behaviour tests check it, from their
# own runs (their test "baseline").
#   ./bazel run //bench/physics3d:baseline [-- --write]
#   ./bazel run //bench/physics3d:baseline -- --long [--write]
rust_binary(
    name = "baseline",
    srcs = ["baseline_main.rs"],
    deps = [":physics3d"],
)

test_suite(
    name = "baseline_test",
    tests = [
        ":behaviour_test",
        ":quality_test",
    ],
)

test_suite(
    name = "baseline_long_test",
    tags = ["manual"],
    tests = [
        ":behaviour_long_test",
        ":quality_long_test",
    ],
)

# The measures' own tests: each on bodies placed where its value is known
# (physics-testing.md, "Measurements that are themselves tested").
rust_test(
    name = "measure_test",
    crate = ":physics3d",
)

rust_test(
    name = "smoke_test",
    srcs = ["smoke_test.rs"],
    deps = [":physics3d"],
)

# Quality as a test: how soon piles of the physics3d mod come to rest, how
# deep they sink and whether stacks stand, against bounds from what Rapier
# and Box3D meet on the same scenes (the source has the values; physics.md,
# "Quality as a test"). TUNE=(a physics3d::Tuning) runs ours tuned so.
rust_test(
    name = "quality_test",
    srcs = ["quality_test.rs"],
    crate_root = "quality_test.rs",
    deps = [":physics3d"],
)

# Quality beyond settling, in 3D: a cube on a ramp, a sphere rolling, a ball
# bouncing, a heavy cube on a light one, against hand calculations and
# Rapier's and Box3D's values on the same scenes (the source has them;
# physics.md, "Quality beyond settling").
rust_test(
    name = "behaviour_test",
    srcs = ["behaviour_test.rs"],
    deps = [":physics3d"],
)

# The bounce families on their long grids (bounces.rs): a few minutes, so
# manual:
#   ./bazel test //bench/physics3d:behaviour_long_test
rust_test(
    name = "behaviour_long_test",
    srcs = [
        "behaviour_long.rs",
        "behaviour_test.rs",
    ],
    crate_features = ["long"],
    crate_root = "behaviour_test.rs",
    tags = ["manual"],
    deps = [":physics3d"],
)

# The same at 1000 and 10 000 bodies: minutes, so manual, and meant for -c opt:
#   ./bazel test //bench/physics3d:quality_long_test
rust_test(
    name = "quality_long_test",
    srcs = [
        "quality_long.rs",
        "quality_test.rs",
    ],
    crate_features = ["long"],
    crate_root = "quality_test.rs",
    tags = ["manual"],
    deps = [":physics3d"],
)
