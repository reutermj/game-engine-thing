load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

# A standalone spike of how entities refer to each other (get-emj.18):
# nothing in the engine depends on it. See lib.rs.
rust_library(
    name = "relations",
    srcs = glob(["*.rs"], exclude = ["bench.rs"]) + [
        "//engine/std/physics:narrow.rs",
        "//engine/std/physics:solver.rs",
    ],
    crate_root = "lib.rs",
    deps = [
        "//engine/ecs",
        "//engine/std/physics:physics_interface",
    ],
)

rust_test(
    name = "relations_test",
    crate = ":relations",
)

rust_binary(
    name = "bench",
    srcs = ["bench.rs"],
    deps = [
        ":relations",
        "//engine/ecs",
        "//engine/std/physics:physics_interface",
    ],
)
